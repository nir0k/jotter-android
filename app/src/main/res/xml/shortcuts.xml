<?xml version="1.0" encoding="utf-8"?>
<!-- The app shortcut New note opens the capture screen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_new_note"
        android:shortcutId="new_note"
        android:shortcutShortLabel="@string/capture_shortcut_short"
        android:shortcutLongLabel="@string/capture_shortcut_long">
        <intent
            android:action="io.github.nir0k.jotter.action.NEW_NOTE"
            android:targetClass="io.github.nir0k.jotter.capture.CaptureActivity"
            android:targetPackage="io.github.nir0k.jotter" />
    </shortcut>
</shortcuts>
